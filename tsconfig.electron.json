{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "types": [
      "node"
    ],
    "lib": [
      "ES2024"
    ],
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "electron/**/*"
  ]
}
